# 1. Veri Yükleme
# Veri Yükleme (Küçük örneklem dosyaları)
veri_saglam <- read.csv("good_sample.csv")
veri_bozuk <- read.csv("fault_sample.csv")

# 2. Shapiro-Wilk Normallik Testi 
# Verideki satır sayısı 5000'den küçükse tamamını, büyükse 5000 tanesini örnekler
n_boyut <- min(5000, nrow(veri_saglam))
shapiro.test(sample(veri_saglam$B1__rms, n_boyut))

# 3. Saglam Rulman Q-Q Plot Grafigi
png("saglam_rulman_qq.png", width = 800, height = 600)
qqnorm(veri_saglam$B1__rms, main = "Saglam Rulman Normallik Grafigi (Q-Q Plot)")
qqline(veri_saglam$B1__rms, col = "red", lwd = 2)
dev.off()

# 4. Bozuk Rulman Q-Q Plot Grafigi
png("bozuk_rulman_qq.png", width = 800, height = 600)
qqnorm(veri_bozuk$B1__rms, main = "Bozuk Rulman RMS Q-Q Plot", col = "blue")
qqline(veri_bozuk$B1__rms, col = "red", lwd=2)
dev.off()

# 5. Zamana Bagli Dogrusal Regresyon Modeli
veri_bozuk$zaman <- 1:nrow(veri_bozuk)
model <- lm(B1__rms ~ zaman, data = veri_bozuk)
summary(model)

# 6. Zaman Serisi ve Regresyon Trend Grafigi
indeks <- seq(1, nrow(veri_bozuk), by = 50)
png("regresyon_trendi.png", width = 800, height = 600)
plot(veri_bozuk$zaman[indeks], veri_bozuk$B1__rms[indeks], type = "l", col = "darkgrey", xlab = "Zaman (Adim)", ylab = "Titresim Siddeti (B1 RMS)", main = "Rulman Zaman Serisi ve Regresyon Trendi")
abline(model, col = "red", lwd=2)
dev.off()
